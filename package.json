{
  "name": "jigsaw",
  "private": true,
  "type": "module",
  "description": "Procedural puzzle-piece icon generator (TypeScript + React + WebGPU)",
  "scripts": {
    "dev": "pnpm --filter @jigsaw/playground dev",
    "build": "pnpm --filter @jigsaw/playground build",
    "preview": "pnpm --filter @jigsaw/playground preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && node .agents/scripts/verify-covenant.mjs",
    "registry:build": "pnpm dlx shadcn@4.23.0 build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@webgpu/types": "^0.1.51",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

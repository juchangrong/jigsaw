{
  "name": "jigsaw",
  "private": true,
  "type": "module",
  "description": "Procedural puzzle-piece icon generator (TypeScript + React + WebGPU)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/playground dev",
    "dev:site": "bun run --cwd apps/site dev",
    "build": "bun run --cwd apps/site build",
    "test": "bun test --timeout 60000",
    "test:watch": "bun test --timeout 60000 --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bun fmt --check && bun run typecheck && bun run test && bun .agents/skills/covenant/scripts/verify-covenant.mjs",
    "registry:build": "bun x shadcn@4.23.0 build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@webgpu/types": "^0.1.51",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2"
  },
  "packageManager": "bun@1.4.4"
}

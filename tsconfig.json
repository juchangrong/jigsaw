{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "types": ["@webgpu/types", "bun"],
    "baseUrl": ".",
    "paths": {
      "@jigsaw/core": ["packages/core/src/index.ts"],
      "@jigsaw/renderer": ["packages/renderer/src/index.ts"],
      "@jigsaw/react": ["packages/react/src/index.tsx"]
    }
  },
  "include": ["packages/*/src", "apps/site/src", "apps/site/dev.ts", "registry", "tests"]
}
